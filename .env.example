# Environment configuration for Phantom AI God

# App config
ENVIRONMENT=development
APP_NAME=phantom-ai-god
APP_PORT=8000

# Security / trade limits
MAX_TRADE_USD=250.0
MAX_DAILY_LOSS_USD=500.0
MAX_DRAWDOWN_PCT=0.15
ENABLE_LIVE_TRADING=false
EMERGENCY_SHUTDOWN=false

# Optional provider config
AI_MODEL_NAME=stub-model
AI_API_KEY=

# Data source config
MARKET_DATA_PROVIDER=stub
CHAIN_ID=1

# Logging
LOG_LEVEL=INFO
